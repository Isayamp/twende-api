{
  "info": {
    "name": "Twende API",
    "description": "Lancez d’abord « POST /auth/login » : le jeton est enregistré et utilisé par toutes les autres requêtes. Comptes de démonstration : admin@twende.test, agent@twende.test, passager@twende.test.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jeton}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "jeton",
      "value": ""
    },
    {
      "key": "jeton_rafraichissement",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentification",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "description": "Inscription (rôle passager)",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom_complet\": \"Aimé Niyonkuru\",\n  \"email\": \"aime@exemple.bi\",\n  \"telephone\": \"+25779000000\",\n  \"mot_de_passe\": \"MotDePasse123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "POST /auth/login",
          "request": {
            "method": "POST",
            "description": "Connexion : jeton d’accès (15 min) et jeton de rafraîchissement",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@twende.test\",\n  \"mot_de_passe\": \"Twende#2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.succes && json.donnees) {",
                  "  pm.collectionVariables.set('jeton', json.donnees.jeton_acces);",
                  "  pm.collectionVariables.set('jeton_rafraichissement', json.donnees.jeton_rafraichissement);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/refresh",
          "request": {
            "method": "POST",
            "description": "Nouveau jeton d’accès (le jeton de rafraîchissement change à chaque usage)",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jeton_rafraichissement\": \"{{jeton_rafraichissement}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.succes && json.donnees) {",
                  "  pm.collectionVariables.set('jeton', json.donnees.jeton_acces);",
                  "  pm.collectionVariables.set('jeton_rafraichissement', json.donnees.jeton_rafraichissement);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "method": "POST",
            "description": "Déconnexion : révoque le jeton de rafraîchissement",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jeton_rafraichissement\": \"{{jeton_rafraichissement}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            }
          }
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "description": "Profil de l’utilisateur connecté",
            "header": [],
            "url": {
