# Copier ce fichier en .env puis remplir les valeurs.
# Ne jamais mettre .env dans Git.
NODE_ENV=development
PORT=3000

# Remplacer MOT_DE_PASSE par le mot de passe PostgreSQL (saisi par vous).
DATABASE_URL="postgresql://postgres:MOT_DE_PASSE@localhost:5432/twende_api_db?schema=public"

# Secret des jetons : une longue phrase aléatoire (32 caractères au minimum).
JWT_SECRET=
JWT_ACCES_DUREE=15m
JWT_RAFRAICHISSEMENT_JOURS=7

# Adresses autorisées pour le front, séparées par une virgule.
CORS_ORIGINES=http://localhost:5173

# log = les e-mails s'affichent dans la console. smtp = envoi réel (Gmail).
EMAIL_MODE=log
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
